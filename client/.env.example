# --- Production (Coolify same-origin / Option A) ---
# Leave empty so the client uses the same host as the page (recommended).
# VITE_API_URL=
# VITE_WS_URL=

# Or set explicitly to your public URL:
# VITE_API_URL=https://collab.yourdomain.com
# VITE_WS_URL=wss://collab.yourdomain.com

# --- Two-subdomain / Cloudflare tunnels (Option B) ---
# VITE_API_URL=https://ws.collab.name.ng
# VITE_WS_URL=wss://ws.collab.name.ng

# --- Local dev ---
# VITE_API_URL=http://localhost:1234
# VITE_WS_URL=ws://localhost:1234
