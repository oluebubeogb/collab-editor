PORT=1234
HOST=0.0.0.0
DATA_DIR=./data
SQLITE_PATH=./data/collab.db

# Browser origin(s) allowed to send credentialed requests (comma-separated).
# For Coolify same-origin, set to your public HTTPS URL:
CORS_ORIGIN=https://collab.yourdomain.com

# Local + tunnel example:
# CORS_ORIGIN=https://ui.collab.name.ng,http://localhost:5173

# Collab Accounts (SSO)
ACCOUNTS_URL=https://accounts.collab.name.ng
USE_ACCOUNTS=true
AUTH_COOKIE_NAME=access_token
COOKIE_DOMAIN=.collab.name.ng
COOKIE_SAMESITE=Lax
# COOKIE_SAMESITE=None  # only if UI and API are on different sites over HTTPS
